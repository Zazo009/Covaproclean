# Copy this file to .env.local and fill in real values before deploying to
# production. Nothing here is required for `npm run dev` — the booking and
# contact forms work without it (emails are logged instead of sent).

# --- Email (Resend) ---
# Create an account at https://resend.com, verify the covaproclean.com
# domain, then generate an API key.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
BOOKING_FROM_EMAIL="Cova Pro Clean <bookings@covaproclean.com>"

# --- Analytics (only loaded after cookie consent — see src/components/Analytics.tsx) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Database (required for the admin dashboard at /admin) ---
# Create a Supabase project, run supabase/schema.sql in its SQL editor, then
# add the credentials here. Without these, bookings are logged but not
# stored, and /admin/bookings shows an empty state.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin dashboard (/admin) ---
# ADMIN_PASSWORD: the shared password for signing in at /admin/login.
# ADMIN_SESSION_SECRET: a long random string used to sign session cookies —
# generate one with `openssl rand -hex 32`. Required for /admin to work at all.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Payments (future) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
